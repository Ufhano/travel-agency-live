# Copy to `.env.local` in this folder (Next.js loads env from `frontend/`).
# From repo root, `npm run db:wipe` truncates Postgres when DATABASE_URL is set.

# Pooled connection string from Neon dashboard (Connection details → pooled).
# If you see "fetch failed", remove channel_binding=require from the string — the app strips it too.
DATABASE_URL=

# Sign-in (required in production). Generate: openssl rand -hex 32
AUTH_SECRET=

# Bootstrap administrator (created on first visit to /login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Invoice email — sent via Gmail SMTP with PDF attachments.
# Create an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification). Spaces in the password are stripped automatically.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: visible sender, e.g. "Nendila Travel & Explorers <you@gmail.com>"
EMAIL_FROM=
# Optional: where customer replies go (defaults to the From address)
EMAIL_REPLY_TO=
